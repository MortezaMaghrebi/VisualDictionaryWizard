<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:background="#1a1a2e">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#16213e"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:progress="0"
        android:progressTint="#4CAF50"
        android:progressBackgroundTint="#333333" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp">

        <TextView
            android:fontFamily="@font/yekan"
            android:id="@+id/counterText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1 / 10"
            android:textSize="14sp"
            android:textColor="#888888"
            android:layout_marginBottom="8dp" />

        <androidx.cardview.widget.CardView
            android:id="@+id/flashCard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="24dp"
            app:cardElevation="12dp"
            app:cardBackgroundColor="#FFFFFF"
            android:foreground="?attr/selectableItemBackground">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="16dp"
                android:clickable="false"
                android:focusable="false">

                <!-- سطح کلمه -->
                <TextView
                    android:id="@+id/levelText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="B2"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:padding="6dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:clickable="false"
                    android:focusable="false"
                    app:cardCornerRadius="16dp" />

                <!-- کلمه انگلیسی (سمت اول کارت) -->
                <TextView
            android:fontFamily="@font/yekan"
                    android:id="@+id/wordText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Example"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="#2c3e50"
                    android:gravity="center"
                    android:layout_centerInParent="true"
                    android:clickable="false"
                    android:focusable="false" />

                <!-- معنی فارسی با مثال و تصویر (سمت دوم کارت) -->
                <RelativeLayout
                    android:id="@+id/meaningRelativeView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"
                    android:clickable="false"
                    android:focusable="false">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="8dp">

                        <!-- تصویر کلمه (فقط در سمت معنی) -->
                        <ImageView
                            android:id="@+id/wordImage"
                            android:layout_width="160dp"
                            android:layout_height="160dp"
                            android:layout_gravity="center"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="16dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_no_image"
                            android:clickable="false"
                            android:focusable="false"
                            app:cardCornerRadius="20dp" />

                        <!-- معنی فارسی -->
                        <TextView
            android:fontFamily="@font/yekan"
                            android:id="@+id/meaningText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="مثال"
                            android:textSize="18sp"
                            android:textColor="#2c3e50"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_marginBottom="16dp" />

                        <!-- مثال انگلیسی -->
                        <TextView
            android:fontFamily="@font/yekan"
                            android:id="@+id/exampleText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="📖 This is an example"
                            android:textSize="15sp"
                            android:textColor="#555555"
                            android:gravity="center"
                            android:layout_marginBottom="12dp"
                            android:lineSpacingExtra="4dp" />

                        <!-- ترجمه مثال -->
                        <TextView
            android:fontFamily="@font/yekan"
                            android:id="@+id/exampleTranslationText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="🇮🇷 این یک مثال است"
                            android:textSize="14sp"
                            android:textColor="#7f8c8d"
                            android:gravity="center"
                            android:lineSpacingExtra="4dp" />

                    </LinearLayout>

                </RelativeLayout>

            </RelativeLayout>

        </androidx.cardview.widget.CardView>

        <TextView
            android:fontFamily="@font/yekan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👆 برای دیدن معنی روی کارت ضربه بزنید"
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginTop="16dp" />

    </LinearLayout>

    <!-- دکمه‌های کنترل - دایره‌ای و ریسپانسیو -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:padding="16dp"
        android:layoutDirection="ltr"
        android:background="#16213e">

        <!-- دکمه قبلی (بزرگ) -->

        <!-- دکمه علاقه‌مندی -->

        <!-- دکمه برگرداندن (بزرگترین) -->

        <!-- دکمه تلفظ -->

        <!-- دکمه یادگرفته شده -->

        <!-- دکمه بعدی (بزرگ) -->

        <ImageButton
            android:id="@+id/prevIcon"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/circle_button_prev"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_prev"
            app:tint="#FFFFFF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.5"
            app:layout_constraintWidth_percent="0.14" />

        <ImageButton
            android:id="@+id/favoriteIcon"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/circle_button_favorite"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_favorite_filled"
            app:tint="#FFFFFF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintStart_toEndOf="@id/prevIcon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.5"
            app:layout_constraintWidth_percent="0.12" />

        <ImageButton
            android:id="@+id/flipIcon"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/circle_button_flip"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_flip"
            app:tint="#FFFFFF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintStart_toEndOf="@id/favoriteIcon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.5"
            app:layout_constraintWidth_percent="0.16" />

        <ImageButton
            android:id="@+id/speakIcon"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/circle_button_speak"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_speaker"
            app:tint="#FFFFFF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintStart_toEndOf="@id/flipIcon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.12" />

        <ImageButton
            android:id="@+id/masteredIcon"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/circle_button_mastered"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_mastered"
            app:tint="#FFFFFF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintStart_toEndOf="@id/speakIcon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.5"
            app:layout_constraintWidth_percent="0.12" />

        <ImageButton
            android:id="@+id/nextIcon"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/circle_button_next"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_next"
            app:tint="#FFFFFF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.416"
            app:layout_constraintStart_toEndOf="@id/masteredIcon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.5"
            app:layout_constraintWidth_percent="0.14" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <Button
        android:id="@+id/exitButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_margin="12dp"
        android:text="🚪 خروج از جلسه مطالعه"
        android:background="@drawable/button_outline"
        android:textColor="#ffffff"
        android:textSize="12sp" />

</LinearLayout>