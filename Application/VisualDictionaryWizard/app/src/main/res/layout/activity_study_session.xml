<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1a1a2e">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#16213e"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" />

    <!-- نوار پیشرفت -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:progress="0"
        android:progressTint="#4CAF50"
        android:progressBackgroundTint="#333333" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!-- شمارنده -->
        <TextView
            android:id="@+id/counterText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1 / 10"
            android:textSize="14sp"
            android:textColor="#888888"
            android:layout_marginBottom="16dp" />

        <!-- فلش کارت اصلی -->
        <androidx.cardview.widget.CardView
            android:id="@+id/flashCard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:cardCornerRadius="24dp"
            app:cardElevation="12dp"
            app:cardBackgroundColor="#FFFFFF"
            android:foreground="?attr/selectableItemBackground">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="24dp">

                <!-- سطح کلمه -->
                <TextView
                    android:id="@+id/levelText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="B2"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:padding="6dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    app:cardCornerRadius="16dp" />

                <!-- کلمه انگلیسی -->
                <TextView
                    android:id="@+id/wordText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Example"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="#2c3e50"
                    android:gravity="center"
                    android:layout_centerInParent="true" />

                <!-- معنی فارسی با مثال -->
                <TextView
                    android:id="@+id/meaningText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="مثال\n\n📖 This is an example"
                    android:textSize="18sp"
                    android:textColor="#555555"
                    android:gravity="center"
                    android:layout_centerInParent="true"
                    android:visibility="gone"
                    android:lineSpacingExtra="6dp" />

            </RelativeLayout>

        </androidx.cardview.widget.CardView>

        <!-- راهنما -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👆 برای دیدن معنی روی کارت ضربه بزنید"
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginTop="16dp" />

    </LinearLayout>

    <!-- دکمه‌های کنترل -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="24dp"
        android:background="#16213e">

        <ImageButton
            android:id="@+id/prevIcon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_prev"
            android:background="@drawable/circle_background_dark"
            android:tint="#FFFFFF"
            android:layout_marginEnd="16dp" />

        <ImageButton
            android:id="@+id/flipIcon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_flip"
            android:background="@drawable/circle_background_accent"
            android:tint="#FFFFFF"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" />

        <ImageButton
            android:id="@+id/speakIcon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_speaker"
            android:background="@drawable/circle_background_dark"
            android:tint="#FFFFFF"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" />

        <ImageButton
            android:id="@+id/nextIcon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_next"
            android:background="@drawable/circle_background_dark"
            android:tint="#FFFFFF"
            android:layout_marginStart="16dp" />

    </LinearLayout>

    <!-- دکمه خروج -->
    <Button
        android:id="@+id/exitButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:text="🚪 خروج از جلسه مطالعه"
        android:background="@drawable/button_outline"
        android:textColor="#FF6B6B" />

</LinearLayout>