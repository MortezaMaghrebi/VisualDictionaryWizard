<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:background="#f5f7fa">

    <!-- هدر با گرادیانت -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@drawable/gradient_background"
        android:gravity="center_vertical">

        <TextView
            android:fontFamily="@font/yekan"
            android:id="@+id/welcomeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="سلام! وقت بخیر"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#fff"/>

        <TextView
            android:fontFamily="@font/yekan"
            android:id="@+id/wordCountText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📚 0 کلمه"
            android:textSize="14sp"
            android:textColor="#ddd"
            android:layout_marginTop="8dp"/>

    </LinearLayout>

    <!-- سطح‌بندی CEFR -->
    <TextView
        android:fontFamily="@font/yekan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📖 سطح خود را انتخاب کنید"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:textColor="#333"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/levelRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:nestedScrollingEnabled="false"/>

    <!-- کلمات اخیر / پیشنهادی -->
    <TextView
        android:fontFamily="@font/yekan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⭐ کلمات محبوب شما"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:textColor="#333"
        android:visibility="gone"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recentWordsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:visibility="gone"/>

    <!-- دکمه‌های پایین (طراحی جدید) -->
    <!-- دکمه‌های پایین (طراحی جدید با دکمه سایر اپ‌ها) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="12dp"
        android:paddingBottom="16dp"
        android:background="#FFFFFF"
        android:elevation="10dp">

        <LinearLayout
            android:id="@+id/searchButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/circle_button_bg_search">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_search"
                    android:tint="#FFFFFF" />

            </FrameLayout>

            <TextView
                android:fontFamily="@font/yekan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="جستجو"
                android:textSize="11sp"
                android:textColor="#3498db"
                android:layout_marginTop="6dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/favoritesButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/circle_button_bg_favorite">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_favorite_outline"
                    android:tint="#FFFFFF" />

            </FrameLayout>

            <TextView
                android:fontFamily="@font/yekan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="علاقه‌مندی"
                android:textSize="11sp"
                android:textColor="#E74C3C"
                android:layout_marginTop="6dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/masteredButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/circle_button_bg_mastered">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_mastered"
                    android:tint="#FFFFFF" />

            </FrameLayout>

            <TextView
                android:fontFamily="@font/yekan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="یادگرفته‌ها"
                android:textSize="11sp"
                android:textColor="#27AE60"
                android:layout_marginTop="6dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/randomButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/circle_button_bg_random">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_random"
                    android:tint="#FFFFFF" />

            </FrameLayout>

            <TextView
                android:fontFamily="@font/yekan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="تصادفی"
                android:textSize="11sp"
                android:textColor="#9C27B0"
                android:layout_marginTop="6dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/otherAppsButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/circle_button_bg_other">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_other_apps"
                    android:tint="#FFFFFF" />

            </FrameLayout>

            <TextView
                android:fontFamily="@font/yekan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="سایر اپ‌ها"
                android:textSize="11sp"
                android:textColor="#FF9800"
                android:layout_marginTop="6dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- بنر تبلیغاتی (فقط برای کاربران رایگان) -->
    <LinearLayout
        android:id="@+id/bannerAdLayout"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:elevation="4dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_crown"
            android:layout_marginEnd="12dp" />

        <TextView
            android:fontFamily="@font/yekan"
            android:id="@+id/bannerAdText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="نسخه پریمیوم: فلش‌کارت نامحدود + حذف تبلیغات"
            android:textSize="13sp"
            android:textColor="#2c3e50" />

        <TextView
            android:fontFamily="@font/yekan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="مشاهده"
            android:textColor="#3498db"
            android:textStyle="bold"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

</LinearLayout>