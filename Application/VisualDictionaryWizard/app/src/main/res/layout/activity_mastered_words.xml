<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:background="#f5f5f5">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#27AE60"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" />

    <!-- نوار آمار -->
    <LinearLayout
        android:id="@+id/statsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#FFFFFF"
        android:elevation="2dp">

        <TextView
            android:fontFamily="@font/yekan"
            android:id="@+id/statsText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 کلمه"
            android:textSize="14sp"
            android:textColor="#27AE60"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/sortButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_sort"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless" />

    </LinearLayout>

    <!-- نوار جستجو -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:layout_marginTop="4dp">

        <EditText
            android:id="@+id/searchEditText"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:hint="🔍 جستجو در کلمات یاد گرفته شده..."
            android:inputType="text"
            android:background="@drawable/search_background"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/clearButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_clear"
            android:padding="12dp"
            android:visibility="gone"
            android:background="?attr/selectableItemBackgroundBorderless" />

    </LinearLayout>

    <!-- لیست کلمات -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false"
        android:visibility="gone" />

    <!-- حالت خالی -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:layout_gravity="center">

            <TextView
            android:fontFamily="@font/yekan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎯"
                android:textSize="64dp" />

            <TextView
            android:fontFamily="@font/yekan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/emptyView"
                android:text="هنوز کلمه‌ای یاد نگرفته‌اید"
                android:textSize="18sp"
                android:textColor="#666"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:gravity="center" />

            <TextView
            android:fontFamily="@font/yekan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="در جلسه مطالعه، روی دکمه سبز ✅ بزنید"
                android:textSize="14sp"
                android:textColor="#999"
                android:layout_marginTop="8dp"
                android:gravity="center" />

        </LinearLayout>

    </ScrollView>

    <!-- دکمه‌های پایین -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#FFFFFF"
        android:elevation="8dp">

        <Button
            android:id="@+id/resetButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="🔄 بازنشانی"
            android:background="@drawable/button_outline_danger"
            android:textColor="#ffffff"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/studyButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1.5"
            android:text="📖 شروع مطالعه"
            android:background="@drawable/button_primary"
            android:textColor="#FFFFFF"
            android:layout_marginStart="6dp" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

</LinearLayout>